(f=~/.fcc/.env; p=$(sed -nE 's/^[[:space:]]*PORT[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' "$f" 2>/dev/null); t=$(sed -nE 's/^[[:space:]]*ANTHROPIC_AUTH_TOKEN[[:space:]]*=[[:space:]]*(.+)/\1/p' "$f" 2>/dev/null); unset $(env | sed -nE 's/^(ANTHROPIC_[^=]+)=.*/\1/p') 2>/dev/null; a=(); w=(--claude-env CLAUDE_CODE_AUTO_COMPACT_WINDOW=260000); for x; do [ "$x" = "--1m" ] && w=() || a+=("$x"); done; k=(); [ -n "$t" ] && k=(--claude-env "ANTHROPIC_AUTH_TOKEN=$t"); exec happy --claude-env ANTHROPIC_BASE_URL="http://127.0.0.1:${p:-8082}" --claude-env CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 --claude-env API_TIMEOUT_MS=1200000 --claude-env CLAUDE_STREAM_IDLE_TIMEOUT_MS=180000 "${w[@]}" "${k[@]}" "${a[@]}")
